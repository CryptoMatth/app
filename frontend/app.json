{
  "expo": {
    "name": "Planibble",
    "slug": "frontend",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "planibble",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mealprepmaster.op32ei",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Aggiungi foto a piatti e ingredienti",
        "NSCameraUsageDescription": "Scatta foto di piatti e ingredienti"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1D8EA2"
      },
      "package": "com.emergent.mealprepmaster.op32ei",
      "versionCode": 148,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aggiungi foto a piatti e ingredienti",
          "cameraPermission": "Scatta foto di piatti e ingredienti"
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-vector-icons/feather",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
